{
  "title": "AI Context Workspace",
  "description": "AI Context Workspace — 从对话到协作的上下文管理",
  "author": "kvker",
  "language": "zh",
  "structure": {
    "readme": "README.md",
    "summary": "SUMMARY.md"
  },
  "plugins": [
    "-lunr",
    "-search",
    "search-pro",
    "code",
    "back-to-top-button",
    "expandable-chapters-small",
    "chapter-fold",
    "splitter",
    "anchor-navigation-ex"
  ],
  "pluginsConfig": {
    "anchor-navigation-ex": {
      "showLevel": false,
      "associatedWithSummary": false,
      "printLog": false,
      "multipleH1": false,
      "mode": "float",
      "float": {
        "showLevelIcon": false,
        "level1Icon": "fa fa-hand-o-right",
        "level2Icon": "fa fa-hand-o-right",
        "level3Icon": "fa fa-hand-o-right"
      }
    },
    "theme-default": {
      "showLevel": false
    }
  }
}
